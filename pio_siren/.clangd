CompileFlags:
  CompilationDatabase: .
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=memw
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
  Add:
    - --target=xtensa-esp32-elf
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/xtensa-esp-elf
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/backward
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include
    - -isystem/home/jos/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include-fixed
    - -I/home/jos/.platformio/packages/framework-arduinoespressif32/libraries/WebServer/src
    - -I/home/jos/.platformio/packages/framework-arduinoespressif32/libraries/WiFi/src
    - -I/home/jos/.platformio/packages/framework-arduinoespressif32/cores/esp32
    - -I/home/jos/.platformio/packages/framework-arduinoespressif32/variants/doitESP32devkitV1
Diagnostics:
  Suppress:
    - pp_file_not_found
    - drv_unknown_argument
    - drv_unknown_argument_with_suggestion
